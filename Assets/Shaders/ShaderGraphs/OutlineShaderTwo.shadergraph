{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3fc1bd61c86b4fb68b989b5db2067adc",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MyFunction (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2381.0,
            "y": -770.0000610351563,
            "width": 221.0,
            "height": 148.9996337890625
        }
    },
    "m_Slots": [
        {
            "m_Id": "450f8b788044468f98857b4b88f85c5c"
        },
        {
            "m_Id": "17364226043d4398babe11076c9a611c"
        },
        {
            "m_Id": "033f32a88b7a4f8c9e0f4468b1bed64b"
        },
        {
            "m_Id": "4e9417922a0b448eb2e312f4f2ae3288"
        },
        {
            "m_Id": "f47c51ca2efb4e9ea8821d429b8cdd2e"
        },
        {
            "m_Id": "ec2fc758d4a44a798d2c8f91ba0d0988"
        },
        {
            "m_Id": "158eda94ae0942649b3161ac59ace9b4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MyFunction",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 accum = 0;\r\n    float totalWeight = 0;\r\n    \r\n    // We use a golden angle to spiral the samples outward\r\n    // This prevents \"box\" artifacts when the blur is large\r\n    float angle = 0.0;\r\n    float goldenAngle = 2.39996323; // Radians\r\n\r\n    for (int i = 0; i < Iterations; i++)\r\n    {\r\n        // Gradually move further away from the center\r\n        float dist = sqrt(float(i) / Iterations) * Radius;\r\n        \r\n        float2 shift = float2(cos(angle), sin(angle)) * dist;\r\n        float2 shiftedUV = UV + shift;\r\n        \r\n        accum += MainTex.Sample(Sampler, shiftedUV);\r\n        \r\n        angle += goldenAngle;\r\n        totalWeight += 1.0;\r\n    }\r\n\r\n    Out = accum / totalWeight;"
}

